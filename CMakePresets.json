{
  "version": 3,
  "cmakeMinimumRequired": { "major": 4, "minor": 2, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": { "BUILD_TESTING": "ON" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-x64",
      "displayName": "Windows x64",
      "inherits": "windows-base",
      "architecture": "x64"
    },
    {
      "name": "windows-arm64",
      "displayName": "Windows ARM64",
      "inherits": "windows-base",
      "architecture": "ARM64"
    }
  ],
  "buildPresets": [
    { "name": "x64-debug", "configurePreset": "windows-x64", "configuration": "Debug" },
    { "name": "x64-release", "configurePreset": "windows-x64", "configuration": "Release" },
    { "name": "arm64-debug", "configurePreset": "windows-arm64", "configuration": "Debug" },
    { "name": "arm64-release", "configurePreset": "windows-arm64", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "x64-debug", "configurePreset": "windows-x64", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "x64-release", "configurePreset": "windows-x64", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "arm64-debug", "configurePreset": "windows-arm64", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "arm64-release", "configurePreset": "windows-arm64", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
